raining parameters\n","training_args = TrainingArguments(\n","    output_dir=\"./results\",          # Where to save the model and checkpoints\n","    eval_strategy=\"epoch\",           # Run evaluation after every epoch\n","    save_strategy=\"epoch\",           # Save a checkpoint after every epoch\n","    learning_rate=2e-5,              # Small learning rate is best for fine-tuning\n","    per_device_train_batch_size=4,   # Batch size (4 is good for CPU)\n","    per_device_eval_batch_size=4,\n","    num_train_epochs=3,              # Let's start with 3 passes through the data\n","    weight_decay=0.01,               # Helps prevent overfitting\n","    load_best_model_at_end=True,     # Keep the best performing version\n","    metric_for_best_model=\"f1\",      # Optimize for F1-Score\n","    fp16=False,                      # MUST be False for CPU\n","    use_cpu=True,                    # Explicitly use CPU\n","    logging_dir=\"./logs\",\n","    logging_steps=50,\n",")\n","\n","# Initialize the Trainer\n","trainer = Trainer(\n","    model=model,\n","    args=training_args,\n","    train_dataset=train_dataset,\n","    eval_dataset=val_dataset,\n","    compute_metrics=compute_metrics,\n",")"],"metadata":{"id":"rvQ7-1LYqPvs","executionInfo":{"status":"ok","timestamp":1767159058671,"user_tz":-330,"elapsed":17271,"user":{"displayName":"Chethiya Ravindranath","userId":"14259011801088406413"}}},"execution_count":11,"outputs":[]},{"cell_type":"code","source":["trainer.train()"],"metadata":{"id":"1GPg_NgJsTj6","colab":{"base_uri":"https://localhost:8080/","height":378},"executionInfo":{"status":"ok","timestamp":1767162006424,"user_tz":-330,"elapsed":2943550,"user":{"displayName":"Chethiya Ravindranath","userId":"14259011801088406413"}},"outputId":"f7713a29-5af9-4b5a-fe44-ab5e4564a894"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/notebook/notebookapp.py:191: SyntaxWarning: invalid escape sequen